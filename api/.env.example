# Copy to api/.env (gitignored) and fill in real values.
# Never commit api/.env — it holds the Deepfire client secret.

DEEPFIRE_CLIENT_ID=
DEEPFIRE_CLIENT_SECRET=

# Port the local live-data proxy listens on. map/vite.config.ts proxies
# /api/* to this port during `npm run dev`.
LIVE_SERVER_PORT=3001

# How often the server re-queries Deepfire in the background (ms). Hotspots
# are satellite detections, not push data, so faster polling doesn't mean
# fresher data past the satellite's revisit rate. 2 min is a reasonable
# default for a demo, not a verified rate limit — check Deepfire's
# "Performance & limits" doc page before lowering it.
POLL_INTERVAL_MS=120000

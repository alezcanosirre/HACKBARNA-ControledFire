# Copy to api/.env (gitignored) and fill in real values.
# Never commit api/.env — it holds the Deepfire client secret.

DEEPFIRE_CLIENT_ID=
DEEPFIRE_CLIENT_SECRET=

# Port the local live-data proxy listens on. map/vite.config.ts proxies
# /api/* to this port during `npm run dev`.
LIVE_SERVER_PORT=3001

# How often the server re-queries clusters/perimeters/hotspots in the
# background (ms). These are satellite detections, not push data, so
# faster polling doesn't mean fresher data past the satellite's revisit
# rate. 2 min is a reasonable default for a demo, not a verified rate
# limit — check Deepfire's "Performance & limits" doc page before lowering it.
POLL_INTERVAL_MS=120000

# fire-spread (PRED / riesgo) is an expensive on-demand simulation, not a
# feed — these two throttle how it's used, independently of POLL_INTERVAL_MS.
FIRE_SPREAD_DURATION_HOURS=6
FIRE_SPREAD_RISK_HOURS=6
FIRE_SPREAD_CACHE_MS=1800000

# Nebius Token Factory — used by POST /api/live-fires/:id/actions to
# recommend a priority action for a real ACTUAL incident. Get a key from the
# Nebius AI Studio console. Without NEBIUS_API_KEY set, the endpoint still
# responds 200 with { status: "unavailable", recommendedAction: null, ... }
# instead of failing — see api/src/live/actionRecommendation.ts.
NEBIUS_API_KEY=
# Base URL/model default to a Llama 3.3 70B endpoint — NOT verified against
# Nebius's current docs or a real account (this dev environment's network
# has api.studio.nebius.ai blocked). Override if your account differs.
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
# How long Nebius has to answer before the call is treated as unavailable (ms).
NEBIUS_TIMEOUT_MS=20000
# How long a recommendation stays cached, keyed to the incident's own data
# (not just its id) — a poll cycle that changes the incident's detection or
# perimeter invalidates the cache on its own. Re-opening the same,
# unchanged incident's panel within this window doesn't re-bill Nebius.
NEBIUS_CACHE_MS=600000
